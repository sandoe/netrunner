# Netrunner Environment Variables
# Copy this file to .env and modify as needed.

# ==========================================
# Authentication
# ==========================================
# "student" is the safe distribution default and disables every privileged
# account/token. Use `./start.sh init server` on an instructor-controlled host.
NETRUNNER_DEPLOYMENT_MODE=student
NETRUNNER_STUDENT_PASSWORD=replace_with_a_class_password
# Server mode only; never include these values in a student distribution.
# NETRUNNER_ADMIN_PASSWORD=replace_with_a_strong_password
# NETRUNNER_ANALYST_PASSWORD=replace_with_a_strong_password

# ==========================================
# JWT Security
# ==========================================
# Set this to a random secure string in production to sign authentication tokens.
# If omitted, Netrunner generates one automatically and saves it to data/.jwt_secret.
NETRUNNER_SECRET_KEY=replace_with_at_least_32_random_bytes

# Machine-to-machine credentials. Do not share these with students.
NETRUNNER_AGENT_TOKEN=replace_with_a_random_token
NETRUNNER_INTERNAL_TOKEN=replace_with_a_random_token

# ==========================================
# Data services
# ==========================================
NETRUNNER_DB_PASSWORD=replace_with_a_url_safe_random_password
INFLUXDB_ADMIN_USERNAME=netrunner-admin
INFLUXDB_ADMIN_PASSWORD=replace_with_a_strong_password
INFLUXDB_TOKEN=replace_with_a_random_token
INFLUXDB_ORG=netrunner
INFLUXDB_BUCKET=traffic

# ==========================================
# AI Integrations
# ==========================================
# OpenAI API Key used by the AI Agent and Cypher query builder
OPENAI_API_KEY=
# Optional autonomous IDS triage. Enable only after testing the configured key.
NETRUNNER_ENABLE_AI_TRIAGE=0

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins. Leave blank for default (localhost only).
NETRUNNER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Optional path on the Docker host. Defaults to ./data/gns3_projects.
GNS3_PROJECTS_PATH=./data/gns3_projects
